DAZI_ENVIRONMENT=development
DAZI_DATABASE_URL=sqlite+aiosqlite:///./data/ligong_dazi.db
DAZI_AUTO_CREATE_SCHEMA=true
DAZI_JWT_SECRET=replace-with-a-long-random-secret
# 公网部署时必须另外设置至少 20 位的管理员口令。
# DAZI_ADMIN_PASSWORD=请在部署平台的私密变量中填写
DAZI_ACCESS_TOKEN_MINUTES=10080
DAZI_CORS_ORIGINS=["http://localhost:3000"]

# 没有模型额度时保持 deterministic 或 auto；auto 在没有 Key 时自动走规则 Agent。
DAZI_AI_PROVIDER=auto
DAZI_AI_VENDOR=custom
DAZI_AI_API_KEY=
DAZI_AI_BASE_URL=https://api.openai.com/v1
DAZI_AI_MODEL=gpt-4.1-mini
DAZI_AI_TIMEOUT_SECONDS=30
DAZI_AI_MAX_TOOL_ROUNDS=6
DAZI_AI_FALLBACK_ENABLED=true
DAZI_CONFIG_FILE_PATH=.env
DAZI_IDENTITY_APPEAL_DIRECTORY=./data/student_id_appeals

# 原生 Android 系统通知。AppID 会编译进 APK；AppKey 和 MasterSecret 只能放在服务端私密变量中。
DAZI_GETUI_APP_ID=
DAZI_GETUI_APP_KEY=
DAZI_GETUI_MASTER_SECRET=
